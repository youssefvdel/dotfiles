{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "newline": false,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#767676",
          "template": "╭─"
        },
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "",
          "background": "#e5e5e5",
          "foreground": "#000000",
          "template": " {{ .Icon }} "
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "\ue0b4",
          "background": "#0087d7",
          "foreground": "#ffffff",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#00af5f",
          "background_templates": [
            "{{ if or .Working.Changed .Staging.Changed }}#ffaf00{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff5f5f{{ end }}"
          ],
          "foreground": "#000000",
          "properties": {
            "branch_icon": "\uf126 ",
            "fetch_status": true
          },
          "template": " {{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} {{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#e5e5e5",
          "foreground": "#000000",
          "properties": {
            "threshold": 500,
            "style": "roundrock"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "status",
          "style": "diamond",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "background": "#ff5f5f",
          "foreground": "#ffffff",
          "template": "  {{ .Code }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#767676",
          "template": "╰─"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#5fd700",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ff5f5f{{ end }}"
          ],
          "template": "❯ "
        }
      ]
    }
  ]
}
